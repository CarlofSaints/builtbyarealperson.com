# ─────────────────────────────────────────────────────────────────────────────
# Copy to .env.local for local work, and set the same keys in Vercel
# (Production AND Preview — a key set only in Production makes previews lie).
# ─────────────────────────────────────────────────────────────────────────────

# Resend. Required for any email to go out at all.
RESEND_API_KEY=

# The From address. The domain here MUST be the exact domain verified in Resend,
# or every send is rejected.
EMAIL_FROM="Built By A Real Person <hello@builtbyarealperson.com>"
EMAIL_REPLY_TO=hello@builtbyarealperson.com

# Where new leads are emailed to. Without this you never hear about a submission.
NOTIFY_EMAIL=

# Vercel Blob. Lead records are stored here, one private file per lead.
BLOB_READ_WRITE_TOKEN=

# Protects /api/cron/followup. The route refuses to run without it rather than
# running unauthenticated, so this is not optional.
CRON_SECRET=

# How long after a submission the booking email goes out. Default 120 minutes.
FOLLOWUP_DELAY_MINUTES=120

# Microsoft Bookings or Calendly link for the 45-minute call. If left blank the
# booking email falls back to asking the customer to reply with times.
NEXT_PUBLIC_BOOKING_URL=

# Optional. Leave blank and no phone number is shown anywhere on the site.
NEXT_PUBLIC_PHONE=
